# Copy to .env.local (git-ignored) for local development, and add the same variables in your
# hosting dashboard (Netlify: Site configuration > Environment variables). Never commit real keys.

# Google AI Studio API key for the Fecto Smart Assistant (/assistant). Required.
GEMINI_API_KEY=

# Optional: Gemini model ids. Check https://ai.google.dev/gemini-api/docs/models for the current list
# and your project's per-model daily limits in AI Studio. The fallback is used when the primary model
# is unavailable or its daily quota is spent. Multiple fallback models can be comma-separated.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-4-hydrogen,gemini-3.8-flash

# Optional: request budget (free tier is about 500 requests/day for this project).
# ASSISTANT_DAILY_CAP=450
# ASSISTANT_PER_USER_DAILY=25
# ASSISTANT_PER_USER_PER_MINUTE=6
